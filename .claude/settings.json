{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run test:ci*)",
      "Bash(npm run test:coverage*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npm run format*)",
      "Bash(npm run verify*)",
      "Bash(npx ng test *)",
      "Bash(npx ng build*)",
      "Bash(npx tsc *)",
      "Bash(npx prettier *)",
      "Bash(npm ls *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git stash*)"
    ],
    "ask": ["Bash(git push*)", "Bash(npm install*)", "Bash(npm i *)", "Bash(npm uninstall*)", "Bash(gh pr create*)"],
    "deny": ["Read(./package-lock.json)", "Read(./dist/**)", "Read(./.angular/**)", "Read(./coverage/**)", "Read(./.env)", "Read(./.env.*)"]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.sh\"", "timeout": 180 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh\"" }
        ]
      }
    ]
  }
}
