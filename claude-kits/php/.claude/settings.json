{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(php artisan test*)",
      "Bash(php artisan route:list*)",
      "Bash(php artisan make:*)",
      "Bash(php artisan about*)",
      "Bash(php artisan optimize:clear)",
      "Bash(php -l *)",
      "Bash(./vendor/bin/pest*)",
      "Bash(./vendor/bin/phpunit*)",
      "Bash(./vendor/bin/phpstan*)",
      "Bash(./vendor/bin/pint*)",
      "Bash(composer dump-autoload*)",
      "Bash(composer audit*)",
      "Bash(composer show*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git add *)",
      "Bash(git stash*)"
    ],
    "ask": [
      "Bash(git push*)",
      "Bash(composer require*)",
      "Bash(composer remove*)",
      "Bash(composer update*)",
      "Bash(php artisan migrate*)",
      "Bash(php artisan db:*)",
      "Bash(php artisan tinker*)",
      "Bash(gh pr create*)"
    ],
    "deny": [
      "Read(./vendor/**)",
      "Read(./composer.lock)",
      "Read(./bootstrap/cache/**)",
      "Read(./public/build/**)",
      "Read(./storage/framework/**)",
      "Read(./.env)",
      "Read(./.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard-bash.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-commit.sh\"", "timeout": 180 }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [{ "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect-files.sh\"" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/format.sh\"" },
          { "type": "command", "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/secret-scan.sh\"" }
        ]
      }
    ]
  }
}
